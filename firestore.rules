rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function admin() { return request.auth != null && request.auth.token.admin == true; }
  function validMemberProject() { let p = request.resource.data; return p.keys().hasAll(['catalogId','name','category','joinDate','reminderEnabled','reminderTime','history','updates']) && p.keys().hasOnly(['catalogId','name','category','joinDate','xUrl','funding','investors','reminderEnabled','reminderTime','history','updates']) && p.catalogId is string && p.catalogId.size() > 0 && p.name is string && p.name.size() > 0 && p.name.size() <= 70 && p.category is string && p.category.size() <= 60 && p.joinDate is string && p.joinDate.size() == 10 && p.reminderEnabled is bool && p.reminderTime is string && p.reminderTime.size() == 5 && p.history is list && p.history.size() <= 5000 && p.updates is list && p.updates.size() <= 5000; }
  function validCatalogProject() { let p = request.resource.data; return p.keys().hasAll(['name','category','description','status']) && p.keys().hasOnly(['name','category','description','xUrl','funding','investors','status']) && p.name is string && p.name.size() > 0 && p.name.size() <= 70 && p.category is string && p.category.size() <= 60 && p.description is string && p.description.size() > 0 && p.description.size() <= 280 && p.status in ['active','draft']; }
  match /users/{uid}/profile/{profileId} { allow read: if owner(uid); allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['name','phone','bio']) && request.resource.data.name is string && request.resource.data.name.size() <= 60 && request.resource.data.phone is string && request.resource.data.phone.size() <= 24 && request.resource.data.bio is string && request.resource.data.bio.size() <= 180; allow delete: if owner(uid); }
  match /users/{uid}/projects/{projectId} { allow read: if owner(uid); allow create, update: if owner(uid) && validMemberProject(); allow delete: if owner(uid); }
  match /catalogProjects/{projectId} { allow read: if request.auth != null; allow create, update: if admin() && validCatalogProject(); allow delete: if admin(); }
  match /{document=**} { allow read, write: if false; }
 }
}
