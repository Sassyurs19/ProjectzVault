rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function validProject() { let p = request.resource.data; return p.keys().hasAll(['name','category','joinDate','reminderEnabled','reminderTime','history','updates']) && p.keys().hasOnly(['name','category','joinDate','xUrl','funding','investors','reminderEnabled','reminderTime','history','updates']) && p.name is string && p.name.size() > 0 && p.name.size() <= 70 && p.category is string && p.category.size() <= 60 && p.joinDate is string && p.joinDate.size() == 10 && (!('xUrl' in p) || (p.xUrl is string && p.xUrl.size() <= 500)) && (!('funding' in p) || (p.funding is string && p.funding.size() <= 120)) && (!('investors' in p) || (p.investors is string && p.investors.size() <= 240)) && p.reminderEnabled is bool && p.reminderTime is string && p.reminderTime.size() == 5 && p.history is list && p.history.size() <= 5000 && p.updates is list && p.updates.size() <= 5000; }
  match /users/{uid}/projects/{projectId} { allow read: if owner(uid); allow create, update: if owner(uid) && validProject(); allow delete: if owner(uid); }
  match /{document=**} { allow read, write: if false; }
 }
}
